        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vmetrics"
          },
          "editorMode": "code",
          "expr": "label_join(max without (alertstate, alertgroup) ((ALERTS{alertstate=\"pending\", namespace=~\"${namespace:regex}\", domain=~\"${domain:regex}\", severity=~\"${severity:regex}\"} * 5) or (ALERTS{alertstate=\"firing\", severity=\"critical\", namespace=~\"${namespace:regex}\", domain=~\"${domain:regex}\", severity=~\"${severity:regex}\"} * 2) or (ALERTS{alertstate=\"firing\", severity=\"warning\", namespace=~\"${namespace:regex}\", domain=~\"${domain:regex}\", severity=~\"${severity:regex}\"} * 3) or (ALERTS{alertstate=\"firing\", severity=\"info\", namespace=~\"${namespace:regex}\", domain=~\"${domain:regex}\", severity=~\"${severity:regex}\"} * 4)), \"alertname\", \" \", \"alertname\", \"diskID\", \"raidName\", \"kubernetes_namespace\", \"pod\", \"deployment\")",
          "legendFormat": "{{alertname}}: {{instance}}",
          "range": true,
          "refId": "A"
