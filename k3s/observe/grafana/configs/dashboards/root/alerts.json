        "getOption": "const S={ok:['Healthy','#73bf69'],info:['Info','#5794f2'],pending:['Pending','#d8dde3'],warning:['Warning','#ff9830'],critical:['Critical','#e02f44']},H={},T={};context.panel.data.series.forEach(f=>{const q=f.fields.find(x=>x.type==='number'),l=q?.labels||{},v=Number((q?.values.buffer||q?.values||[]).at(-1)||0);if(!v)return;const n=l.namespace||'unlabeled',d=l.domain||'unlabeled',s=l.state||'unknown';H[n]||={};H[n][d]||={};H[n][d][s]=(H[n][d][s]||0)+v;T[s]=(T[s]||0)+v});const D=Object.entries(H).map(([n,ds],i)=>({name:n,itemStyle:{color:['#526b82','#60788d','#47677a','#65758b'][i%4]},children:Object.entries(ds).map(([d,ss])=>({name:d,itemStyle:{color:'#40566d'},children:Object.entries(ss).map(([s,v])=>({name:S[s]?.[0]||s,value:v,itemStyle:{color:S[s]?.[1]||'#8e8e8e'}}))}))})),L=Object.entries(T).map(([s,v])=>({name:S[s]?.[0]||s,value:v}));return {legend:{bottom:2,left:'center',icon:'circle',itemWidth:8,itemHeight:8,selectedMode:false,textStyle:{color:'#c7d0d9',fontSize:10},data:L.map(x=>x.name),formatter:n=>`${n} ${L.find(x=>x.name===n).value}`},tooltip:{trigger:'item',confine:true,formatter:p=>`<strong>${p.treePathInfo.slice(1).map(x=>x.name).join(' / ')}</strong><br/>${p.value} alert instance${p.value===1?'':'s'}`},series:[{type:'sunburst',data:D,radius:['38%','86%'],center:['50%','46%'],nodeClick:'rootToNode',itemStyle:{borderColor:'#111827',borderWidth:3},levels:[{},{r0:'38%',r:'50%',label:{rotate:0,color:'#f3f4f6',fontSize:11,fontWeight:600}},{r0:'50%',r:'65%',label:{rotate:0,color:'#f3f4f6',fontSize:11,fontWeight:700,formatter:p=>p.name}},{r0:'65%',r:'86%',label:{show:true,rotate:0,color:'#fff',fontSize:12,fontWeight:700,formatter:p=>String(p.value)}}]}]};",
