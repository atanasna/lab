      },
      "options": {
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "editor": {
          "format": "auto"
        },
        "editorMode": "code",
        "followTheme": true,
        "getOption": "const states = { 1: { color: '#ffffff', name: 'pending' }, 2: { color: '#e02f44', name: 'critical' }, 3: { color: '#ff9830', name: 'warning' }, 4: { color: '#5794f2', name: 'info' } };\nconst rows = [];\nconst rowByAlert = new Map();\nconst segments = new Map();\n\ncontext.panel.data.series.forEach((frame) => {\n  const timeField = frame.fields.find((field) => field.type === 'time');\n  const valueField = frame.fields.find((field) => field.type === 'number');\n  if (!timeField || !valueField) {\n    return;\n  }\n\n  const labels = valueField.labels || {};\n  const alert = `${labels.alertname || valueField.name}: ${labels.instance || 'unlabeled'}`;\n  let row = rowByAlert.get(alert);\n  if (row === undefined) {\n    row = rows.length;\n    rowByAlert.set(alert, row);\n    rows.push(alert);\n  }\n\n  const times = timeField.values.buffer || timeField.values;\n  const values = valueField.values.buffer || valueField.values;\n  for (let index = 0; index < values.length; index += 1) {\n    const state = Number(values[index]);\n    if (values[index] == null || !states[state]) {\n      continue;\n    }\n\n    const start = new Date(times[index]).getTime();\n    const next = index + 1 < times.length ? new Date(times[index + 1]).getTime() : start + 60000;\n    const key = `${alert}:${start}`;\n    const existing = segments.get(key);\n    if (!existing || state > existing[3]) {\n      segments.set(key, [start, Math.max(next, start + 1), row, state]);\n    }\n  }\n});\n\nconst data = Array.from(segments.values()).sort((left, right) => left[2] - right[2] || left[0] - right[0]);\nconst visibleRows = Math.min(6, Math.max(rows.length, 1));\nconst zoomEnd = (visibleRows / Math.max(rows.length, 1)) * 100;\nconst chart = context.panel.chart;\nif (chart) {\n  chart.__alertTimelineRows = rows.length;\n  if (!chart.__alertTimelineWheelHandler) {\n    chart.__alertTimelineWheelHandler = (event) => {\n      const dataZoom = chart.getOption().dataZoom?.[0];\n      const rowCount = Math.max(chart.__alertTimelineRows || 1, 1);\n      const span = (dataZoom?.end ?? 100) - (dataZoom?.start ?? 0);\n      const maxStart = Math.max(100 - span, 0);\n      const step = 100 / rowCount;\n      const start = Math.min(Math.max((dataZoom?.start ?? 0) + Math.sign(event.deltaY) * step, 0), maxStart);\n      chart.dispatchAction({ type: 'dataZoom', dataZoomIndex: 0, start, end: start + span });\n      event.preventDefault();\n      event.stopPropagation();\n    };\n    chart.getDom().addEventListener('wheel', chart.__alertTimelineWheelHandler, { passive: false });\n  }\n}\n\nreturn {\n  grid: { left: 360, right: 38, top: 12, bottom: 34 },\n  tooltip: {\n    trigger: 'item',\n    formatter: (params) => {\n      const [start, end, row, state] = params.data;\n      return `<strong>${rows[row]}</strong><br/>${states[state].name}<br/>${new Date(start).toLocaleString()} - ${new Date(end).toLocaleString()}`;\n    }\n  },\n  xAxis: { type: 'time', boundaryGap: false },\n  yAxis: {\n    type: 'category',\n    inverse: true,\n    data: rows,\n    axisLabel: { margin: 12, interval: 0 }\n  },\n  dataZoom: [\n    { type: 'slider', yAxisIndex: 0, orient: 'vertical', right: 4, width: 12, start: 0, end: zoomEnd, zoomLock: true }\n  ],\n  series: [{\n    type: 'custom',\n    renderItem: (params, api) => {\n      const start = api.coord([api.value(0), api.value(2)]);\n      const end = api.coord([api.value(1), api.value(2)]);\n      const height = Math.max(api.size([0, 1])[1] * 0.68, 5);\n      return {\n        type: 'rect',\n        shape: { x: start[0], y: start[1] - height / 2, width: Math.max(end[0] - start[0], 1), height },\n        style: { fill: states[api.value(3)].color }\n      };\n    },\n    encode: { x: [0, 1], y: 2 },\n    data\n  }]\n};",
        "renderer": "canvas",
        "themeEditor": {
          "config": "{}",
          "name": "default"
        },
        "visualEditor": {
          "code": "return { dataset: context.editor.dataset, series: context.editor.series };",
          "dataset": [],
          "series": []
        }
      },
